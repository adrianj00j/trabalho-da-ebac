{
  "paths": {
    "novels_dir": "data/novels",
    "vector_db_dir": "data/vector_db",
    "output_dir": "data/output"
  },
  "embeddings": {
    "model_name": "nomic-ai/nomic-embed-text-v1.5",
    "trust_remote_code": true,
    "chunk_size": 1500,
    "chunk_overlap": 300
  },
  "llm": {
    "provider": "openai_compatible",
    "base_url": "http://127.0.0.1:5000/v1",
    "api_key": "none",
    "model_name": "default",
    "temperature": 0.7
  }
}
